{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-self-improvement:skill-improvement:repository-manifest:1",
  "title": "Skill改善MVPの対象repo manifest（実運用開始前の必須入力。承認票の代わりではない）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "classification", "stage", "timezone", "period", "ledger_location", "approval", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"$ref": "#/$defs/id"},
    "classification": {"$ref": "#/$defs/classification"},
    "stage": {"enum": ["RECORD_ONLY", "RECORD_AND_MANUAL_IMPROVEMENT"]},
    "timezone": {"type": "string", "pattern": "^(UTC|[A-Z][A-Za-z_]+(/[A-Z][A-Za-z_]+)+)$"},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"}
      }
    },
    "ledger_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {"enum": ["APPROVED_LOCAL_DIRECTORY", "PUBLIC_FIXTURE"]},
        "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_by", "approved_at", "ref"],
      "properties": {
        "approved_by": {"$ref": "#/$defs/actor"},
        "approved_at": {"$ref": "#/$defs/utc"},
        "ref": {"$ref": "#/$defs/ref"}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_id", "allowed_roots", "read_items", "classification", "owner"],
        "properties": {
          "repository_id": {"$ref": "#/$defs/id"},
          "allowed_roots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"}
          },
          "read_items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"enum": ["EXPLICIT_INPUT", "END_RECORD", "PR_REVIEW_COMMENT", "COMMIT_MESSAGE"]}
          },
          "classification": {"$ref": "#/$defs/classification"},
          "owner": {"$ref": "#/$defs/actor"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "actor": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 200},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL"]}
  }
}
