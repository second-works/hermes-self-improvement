# Copy this file to .env; never commit .env or real credentials.
APP_NAME=replace-me
APP_PORT=8000
APP_DATA_DIR=.data
APP_HEALTHCHECK_URL=http://127.0.0.1:8000/health
APP_HEALTHCHECK_REQUIRED=0
APP_EXPECT_RUNNING=0
# Document additional command requirements in the app repository.
APP_REQUIRED_COMMANDS=git
