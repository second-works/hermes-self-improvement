{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worklog selection response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "decisions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "state",
          "reason",
          "evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^c-[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "needs_check",
              "awaiting_approval",
              "investigating",
              "resolved_in_log",
              "hold"
            ]
          },
          "reason": {
            "enum": [
              "explicit_open",
              "explicit_approval",
              "explicit_investigation",
              "linked_success",
              "insufficient_context",
              "conflicting_evidence",
              "unsupported_format"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^r-[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
